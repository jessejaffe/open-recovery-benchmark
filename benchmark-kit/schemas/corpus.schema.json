{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillopen.org/benchmark-kit/schemas/corpus.schema.json",
  "title": "StillOpen benchmark corpus",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "title", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "benchmark-corpus" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "title": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "format", "damageClass", "input", "groundTruth", "provenance"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
          "category": { "enum": ["damaged-full-restoration", "damaged-partial-restoration", "healthy-control"] },
          "format": { "type": "string", "minLength": 1 },
          "damageClass": { "type": "string", "minLength": 1 },
          "input": { "$ref": "#/$defs/file" },
          "groundTruth": {
            "type": "object",
            "required": ["validator", "path", "byteLength", "sha256"],
            "properties": {
              "validator": { "enum": ["exact-sha256-v1", "raster-rgba-v1", "pdf-render-text-v1", "zip-entry-bytes-v1"] },
              "path": { "type": "string", "minLength": 1 },
              "byteLength": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          },
          "provenance": {
            "type": "object",
            "required": ["source", "license"],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "license": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "file": {
      "type": "object",
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
