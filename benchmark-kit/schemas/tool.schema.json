{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillopen.org/benchmark-kit/schemas/tool.schema.json",
  "title": "StillOpen benchmark tool",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "vendor", "product", "version", "platform", "synthetic", "acquisition", "adapter"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "benchmark-tool" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "vendor": { "type": "string", "minLength": 1 },
    "product": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "synthetic": { "type": "boolean" },
    "acquisition": {
      "type": "object",
      "required": ["source"],
      "properties": { "source": { "type": "string", "minLength": 1 } },
      "additionalProperties": true
    },
    "adapter": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "executable", "args", "outputFile"],
          "properties": {
            "kind": { "const": "command" },
            "executable": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } },
            "outputFile": { "type": "string", "minLength": 1 },
            "exitCodeDisposition": {
              "type": "object",
              "additionalProperties": { "enum": ["refusal", "error", "unavailable", "paywalled", "no-output"] }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "instructions"],
          "properties": {
            "kind": { "const": "guided" },
            "instructions": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
