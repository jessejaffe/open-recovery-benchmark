{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stillopen.org/benchmark-kit/schemas/guided-observations.schema.json",
  "title": "StillOpen guided benchmark observations",
  "type": "object",
  "required": ["schemaVersion", "kind", "id", "toolId", "cases"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "benchmark-guided-observations" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "toolId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "productOutcome", "attemptedAt"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,79}$" },
          "productOutcome": { "enum": ["success", "refusal", "error", "timeout", "unavailable", "paywalled", "no-output"] },
          "attemptedAt": { "type": "string", "format": "date-time" },
          "productMessage": { "type": "string" },
          "operatorNote": { "type": "string" },
          "accessConstraint": {
            "type": "object",
            "required": ["kind", "stage", "scope"],
            "properties": {
              "kind": {
                "enum": [
                  "format-not-supported",
                  "service-maintenance",
                  "free-tier-quota",
                  "account-required",
                  "payment-required",
                  "software-install-required",
                  "region-restricted",
                  "unknown-unavailable"
                ]
              },
              "stage": {
                "enum": [
                  "before-upload",
                  "after-upload",
                  "before-processing",
                  "after-processing",
                  "before-download",
                  "not-applicable"
                ]
              },
              "scope": { "enum": ["case", "session", "product-path"] },
              "limit": {
                "type": "object",
                "required": ["maximum", "unit"],
                "properties": {
                  "maximum": { "type": "integer", "minimum": 1 },
                  "unit": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "note": { "type": "string" }
            },
            "additionalProperties": false
          },
          "outputPath": { "type": "string", "minLength": 1 },
          "attachments": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
